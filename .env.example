# ── Required ──────────────────────────────────────────────────────────────
# Parallel AI search (primary): https://api.parallel.ai — 16,000 free queries
PARALLEL_API_KEY=
# PARALLEL_PROCESSOR=base|pro|ultra (default base — free tier)

# ── Gemini 2.5 Flash synthesis ────────────────────────────────────────
# https://aistudio.google.com — 1,500 req/day free per key.
# Single-key mode (legacy):
GEMINI_API_KEY=
# OR multi-key mode for round-robin (recommended when running eval ablations
# or expecting heavy English-synth load — Gemini free tier is 1500 req/day
# per key; round-robin across N keys gives N× headroom).
# Comma-separated keys, throttle-aware failover on 429 honoring Retry-After.
# GEMINI_API_KEYS=AIzaSy_xxx,AIzaSy_yyy

# ── Groq (planning + conflict detection + judges) ──────────────────────────
# https://console.groq.com — ~1M tokens/day free on Llama 3.3 70B per key.
# Single-key mode (legacy):
GROQ_API_KEY=
# OR multi-key mode for round-robin (preferred when running eval ablations):
# Comma-separated list of keys. Round-robin per request, 60s throttle on 429
# (Retry-After header honored when present). Lets you stitch together quota
# from multiple Groq accounts to survive a full eval ablation.
# GROQ_API_KEYS=gsk_xxx,gsk_yyy

# GitHub Models (eval judge GPT-4o-mini): GitHub Settings > Developer settings > PAT (classic)
GITHUB_TOKEN=

# ── Optional (fallbacks) ──────────────────────────────────────────────────
# Tavily search fallback: https://tavily.com — 1,000 free credits/month
TAVILY_API_KEY=

# Jina Reader fallback: set to "1" to fully disable. When enabled (default),
# extraction falls through to https://r.jina.ai/<url> if Trafilatura + Tavily
# both yield <200 chars. URLs are disclosed to Jina's infrastructure; operators
# with sensitive deployments may set JINA_READER_DISABLED=1 to opt out.
JINA_READER_DISABLED=

# Serper search last resort: https://serper.dev — 2,500 free queries
SERPER_API_KEY=

# OpenRouter (synthesis fallback if Gemini rate-limits): https://openrouter.ai
OPENROUTER_API_KEY=

# Cohere Rerank v3.5 — optional augmentation between FlashRank and the 5-factor
# scoring pass. English queries only (Devanagari/Tamil/Bengali skip Cohere and
# stay on FlashRank). Free trial: 1000 reranks/month.
# https://dashboard.cohere.com — leave blank to disable.
COHERE_API_KEY=

# Sarvam Model API — alternative Indic-first synthesizer: https://docs.sarvam.ai
# OpenAI-compatible endpoint. Use SYNTH_PROVIDER=sarvam to route synthesis here.
SARVAM_API_KEY=
SARVAM_MODEL=sarvam-m

# Cerebras Cloud — very fast Llama inference (~2000 tok/s). 8K context cap;
# we automatically skip Cerebras for prompts that wouldn't fit, falling
# through to the next provider in the chain. https://cloud.cerebras.ai
CEREBRAS_API_KEY=
# Default model. Free accounts typically have access to llama3.1-8b.
# Other models gated per-account: qwen-3-235b-a22b-instruct-2507,
# zai-glm-4.7, gpt-oss-120b. Verify via cloud.cerebras.ai/models.
CEREBRAS_MODEL=llama3.1-8b
# CEREBRAS_BASE_URL=https://api.cerebras.ai/v1

# Ollama local synth fallback. Requires `ollama serve` running locally with
# the model pulled (e.g. `ollama pull llama3.1:8b`). Used when ALL cloud
# providers are unreachable — unlimited because it's your own machine.
# Leave unset on HF Spaces (no Ollama there); the chain skips it gracefully.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1:8b

# Synthesis provider selector — chooses the FIRST provider in the fallback
# chain. The chain then tries the rest in this order if the first fails:
#   gemini     → sarvam → openrouter → cerebras → ollama   (default)
#   sarvam     → gemini → openrouter → cerebras → ollama
#   openrouter → gemini → sarvam     → cerebras → ollama
#   cerebras   → gemini → sarvam     → openrouter → ollama
#   ollama     → gemini → sarvam     → openrouter → cerebras
SYNTH_PROVIDER=gemini

# ── Caching ──────────────────────────────────────────────────────────────
# Search-result cache TTL (seconds). 24h default. Set to 0 to disable; use a
# shorter value (e.g. 3600) if you care about result freshness in production.
# Recency-sensitive intents (recency_check) bypass the cache automatically.
SEARCH_CACHE_TTL_S=86400
# SEARCH_CACHE_DISABLED=1   # uncomment to force fresh searches every turn

# ── Tuning ────────────────────────────────────────────────────────────────
AGENT_MAX_ITER=5
AGENT_MAX_SOURCES=8
CHUNK_SIZE=500
MAX_CONTEXT_TOKENS=6000
LOG_LEVEL=INFO

# ── Deployment ────────────────────────────────────────────────────────────
# SQLite file path. Mount this onto persistent storage in production.
DB_PATH=research.db

# CORS allow-list for the FastAPI backend (comma-separated).
ALLOWED_ORIGINS=http://localhost:3000

# V3.8: retrieval mode.
#   auto    (default) → use hybrid (BM25 + sqlite-vec RRF) when the extension
#                       loads, gracefully fall back to lexical otherwise.
#   hybrid           → require hybrid; FastAPI refuses to start if sqlite-vec
#                       cannot load (use this in CI / eval runs where you need
#                       reproducibility, not silent degradation).
#   lexical          → force BM25 + FlashRank only (ablation baseline).
RETRIEVAL_MODE=auto

# Deprecated alias kept for backwards compatibility (HYBRID_RETRIEVAL=1 → hybrid,
# =0 → lexical). Prefer RETRIEVAL_MODE for new deployments.
# HYBRID_RETRIEVAL=

# ── Model overrides ──────────────────────────────────────────────────────
# Default Gemini model for synthesis. Pinned in code; override if Google
# releases a newer flash variant.
# GEMINI_MODEL=gemini-2.5-flash

# Eval judge model overrides. Defaults to GitHub Models GPT-4o-mini for
# different-family judging (Gemini generator + OpenAI judge avoids anchor bleed).
# JUDGE_PROVIDER=github
# JUDGE_MODEL=gpt-4o-mini

# ── Failure policy timeouts (seconds) ─────────────────────────────────────
# These are the per-stage circuit-breaker timeouts surfaced in the README's
# "Runtime Failure Budget" section. Defaults are conservative for free-tier
# providers; tune if you have paid quota.
# FAILURE_POLICY_PLAN_TIMEOUT_S=8
# FAILURE_POLICY_SEARCH_TIMEOUT_S=12
# FAILURE_POLICY_FETCH_TIMEOUT_S=15
# FAILURE_POLICY_SELECT_TIMEOUT_S=10
# FAILURE_POLICY_SYNTHESIZE_TIMEOUT_S=30
# FAILURE_POLICY_CONFLICT_TIMEOUT_S=10
# FAILURE_POLICY_VERIFY_TIMEOUT_S=15
# FAILURE_POLICY_MAX_TURN_TIME_S=120
# FAILURE_POLICY_MAX_HOPS=2

# ── SSE + eval tuning ─────────────────────────────────────────────────────
# SSE_HEARTBEAT_S=15           # heartbeat comment cadence (Phase 1.25)
# EVAL_PER_QUESTION_TIMEOUT_S=140
# HEALTH_CACHE_TTL_S=60
# APPROVAL_TIMEOUT_S=300       # Phase 2 plan-approval gate timeout
# HISTORY_RETRIEVAL_LIMIT=10

# ── Selection strategy ───────────────────────────────────────────────────
# heuristic = legacy max-2-per-domain (default, per Phase 5c verification)
# mmr       = λ-weighted MMR via rank_and_select_mmr; expose MMR_LAMBDA to tune
# CONTEXT_SELECTION_STRATEGY=heuristic
# MMR_LAMBDA=0.7

# ── Source trust + provider usage ────────────────────────────────────────
# SOURCE_TRUST_DISABLED=0      # set 1 to zero out trust-tier scoring weight
# PROVIDER_USAGE_DISABLED=0    # set 1 to skip the daily quota counter

# ── Domain blocklist (Phase 5b) ──────────────────────────────────────────
# Default blocks reddit, twitter, x, tiktok, quora, instagram, facebook, pinterest.
# Comma-separated additional domains extend the default. Use "none" to disable.
# Entries are validated: max 50 extras, each ≤ 255 chars, [a-z0-9.-] only.
# Invalid entries are skipped with a warning rather than raising.
# RETRIEVAL_DOMAIN_BLOCKLIST=

# ── Supplementary search providers (Tier 1 — free, no new keys) ──────────
# Wikipedia REST API (free, no key). Disable with WIKIPEDIA_DISABLED=1.
# Used for DEFINITION-intent sub-queries; supplements primary providers.
# WIKIPEDIA_DISABLED=

# Serper Scholar uses existing SERPER_API_KEY. Disable with SCHOLAR_DISABLED=1.
# Used when planner.expected_source_types contains "academic".
# SCHOLAR_DISABLED=

# ── Sarvam Indic auto-routing (Tier 1) ─────────────────────────────────
# When 1 (default), queries in Devanagari/Tamil/Bengali script auto-route
# to Sarvam first regardless of SYNTH_PROVIDER setting (provided SARVAM_API_KEY
# is set). Set to 0 to disable.
# SARVAM_INDIC_AUTO=1

# ── Planner provider override (Tier 1) ─────────────────────────────────
# auto (default) = Cerebras when available + prompt fits, else Groq
# cerebras = force Cerebras
# groq = force Groq
# gemini = use Gemini structured-output mode (Tier 3)
# PLANNER_PROVIDER=auto

# ── Claim verifier provider override (Tier 1) ──────────────────────────
# auto (default) = DeepSeek R1 via OpenRouter when available, else GPT-4o-mini
# deepseek = force DeepSeek R1
# gpt4o = force GPT-4o-mini via GitHub Models
# CLAIM_VERIFIER_PROVIDER=auto

# ── Language detection (Tier 3) ──────────────────────────────────────────
# Tier 1 (Unicode script) and Tier 2 (Hinglish/romanized-Indic keywords)
# always run. Tier 3 (langid statistical classifier) catches Latin-script
# queries that the keyword wordlist misses. Set to 1 to skip Tier 3 (offline
# environments, smaller deployments, or perf-sensitive tests).
# LANG_DETECT_DISABLE_FASTTEXT=0

# ── Multi-key rotation tuning ─────────────────────────────────────────────
# Lazy env reload interval for KeyRotator. Lets you add/remove keys via the
# HF Spaces secrets UI without a container restart. Default 60s. Set 0 to
# disable (static keys; one read at startup).
# KEY_ROTATION_REFRESH_S=60

# Persist throttle state to SQLite so 429 cooldowns survive container
# restarts (HF Spaces free tier loses all in-memory state on restart).
# Only SHA256 hashes of keys are stored — never the raw key. Default 0.
# KEY_ROTATION_PERSIST=0

# ── Quota-exhaustion alerting ────────────────────────────────────────────
# When set, the agent POSTs a JSON payload to this URL when any provider
# crosses QUOTA_ALERT_THRESHOLD of its documented daily quota. Compatible
# with Slack/Discord incoming webhooks or any HTTP endpoint accepting JSON.
# Leave blank to disable.
# QUOTA_WEBHOOK_URL=
# QUOTA_ALERT_THRESHOLD=0.8
# QUOTA_ALERT_COOLDOWN_S=3600

# ── Reverse-proxy hop count ──────────────────────────────────────────────
# When deployed behind a known reverse proxy (Cloudflare, HF Spaces edge),
# set TRUSTED_PROXY_COUNT to the number of trusted hops so the smoke-eval
# rate limiter uses the real client IP from X-Forwarded-For. Default 0 means
# "don't trust the header" — only request.client.host is used.
# TRUSTED_PROXY_COUNT=0
